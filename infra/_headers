# Cloudflare Pages headers. Copied to the root of the deployed directory by infra/deploy.sh.

# Data is rebuilt once a night; an hour of cache with a day of stale-while-revalidate means a
# reader never waits for the origin, and CORS lets other people build things on the same files.
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

# Feeds are source-scoped: /data/<source>/feeds/<kind>/<name>.xml — and Cloudflare Pages ignores a
# wildcard in the middle of a path, which we measured: the deploy carrying both /data/*/feeds/* and
# a literal rule reported the literal one. infra/deploy.sh therefore appends one literal block per
# source id found in sources.json. Do not add a /data/*/feeds/* rule here; it does nothing.

# Province outlines change only when the map is rebuilt, and the filename never changes, so keep
# the window short enough that a rebuild is picked up the next day.
/map/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Hashed filenames: safe to keep forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # The site is static and takes no input, but it renders names extracted by OCR from scanned
  # pages, so a policy that forbids inline and third-party script costs nothing and closes that
  # class outright. 'unsafe-inline' is needed for style only: the app uses style attributes, and
  # the Google Fonts stylesheet is remote. There is no inline <script> in the built page.
  #
  # connect-src names Hugging Face because the document page reads the full text of one document
  # straight out of the dataset with range requests — the layer is 12 GB and cannot be built into
  # the site. `resolve/` redirects to whichever CDN host is serving the file, and a redirect is
  # checked against connect-src too, so the redirect targets are listed as well. What comes back
  # is rendered as text, never as markup.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://huggingface.co https://cdn-lfs.huggingface.co https://cdn-lfs-us-1.hf.co https://transfer.xethub.hf.co; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'
