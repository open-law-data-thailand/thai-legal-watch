# Cloudflare Pages headers. Copied to the root of the deployed directory by infra/deploy.sh.

# Data is rebuilt once a night; an hour of cache with a day of stale-while-revalidate means a
# reader never waits for the origin, and CORS lets other people build things on the same files.
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

# Feeds are source-scoped: /data/<source>/feeds/<kind>/<name>.xml
# The first deploy served these as application/xml, so either Pages ignores a wildcard in the
# middle of a path or it will not let _headers override a Content-Type it derived from .xml.
# Both spellings are listed; X-TLW-Feed-Rule says which one (if either) took effect.
/data/*/feeds/*
  Content-Type: application/atom+xml; charset=utf-8
  X-TLW-Feed-Rule: wildcard
/data/ratchakitcha/feeds/*
  Content-Type: application/atom+xml; charset=utf-8
  X-TLW-Feed-Rule: literal

# Province outlines change only when the map is rebuilt, and the filename never changes, so keep
# the window short enough that a rebuild is picked up the next day.
/map/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Hashed filenames: safe to keep forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
